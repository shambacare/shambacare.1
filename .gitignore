# ===============================================
# AI / Model Files (CRITICAL FIX)
# ===============================================
# Exclude LARGE model cache files (>100 MB) to avoid GitHub push errors
# These will be downloaded separately during deployment
shambacare-ai-service/model_cache/
*.onnx
*.pkl
*.pb

# Only exclude backup/temp files for models
*.h5.backup
*.h5.tmp
*.model.backup
*.pkl.backup

# ===============================================
# IMPORTANT: Keep these small model files (~14-20 MB)
# These are needed for the AI service to work
# ===============================================
!best_model.h5
!class_names.json
!requirements.txt

# Keep READMEs
!README.md
!LICENSE

# ===============================================
# Git Large File Storage (LFS) tracking
# If you use Git LFS, track large files here
# ===============================================
# *.h5 filter=lfs diff=lfs merge=lfs -text
